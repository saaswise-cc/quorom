# Quorom — environment. Copy to .env (git-ignored) and fill in.
# In a deployed run these come from the customer environment's secret store,
# never from a file in the repository.

# --- The product database, in the customer's environment ------------------- #
# Schema: migrations/. One account per deployment.
DATABASE_URL=postgresql://user:password@host:5432/quorom
ACCOUNT_DOMAIN=acme.com

# --- Gong (the meeting source) --------------------------------------------- #
GONG_ACCESS_KEY=
GONG_ACCESS_KEY_SECRET=
# GONG_BASE_URL=https://api.gong.io

# --- Salesforce ------------------------------------------------------------ #
# Deployed: client credentials via a Connected / External Client App. No paste,
# no expiry ritual.
SF_TOKEN_URL=https://your-domain.my.salesforce.com/services/oauth2/token
SF_CLIENT_ID=
SF_CLIENT_SECRET=
#
# Pilot shortcut: a token pasted from `sf org display`. Expires in ~2 hours —
# the runbook is in docs/salesforce-access.md. Leave both blank to use the flow above.
SF_ACCESS_TOKEN=
SF_INSTANCE_URL=
# SF_API_VERSION=v61.0

# --- HubSpot --------------------------------------------------------------- #
HUBSPOT_SERVICE_KEY=

# --- Run tuning ------------------------------------------------------------ #
# Monday of the target week. Unset = the current week.
# WEEK_START=2026-08-17
# TZ_OFFSET=-04
# SHORTLIST_SIZE=3        people per company on the stakeholder list
# GROUP_CALL_MIN=8        above this many external attendees it is a group call
# RECENT_DAYS=90          how far back still counts as recent contact — and,
#                         with no dates given, how far back `quorom import` goes
# OUTPUT_DIR=output
#
# Substrings of Account.Type that mark an existing customer. Empty = the gate is
# off and ICP fit is employee band + HQ geography only. Leave it off unless your
# Type field is genuinely maintained as a lifecycle field.
# CUSTOMER_ACCOUNT_TYPES=

# --- Tests ----------------------------------------------------------------- #
# A Postgres the test suite may create and drop databases on. Unset = the
# database tests skip.
# QUOROM_TEST_DSN=postgresql://postgres@localhost:5432/postgres
